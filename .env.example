# Copie para .env (make up faz isso automaticamente se .env não existir).
# Valores abaixo são APENAS para desenvolvimento local.

ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_PASSWORD=postgres_dev
POSTGRES_DB=nucleo
# usuário de migração (dono das tabelas, executa DDL)
MIGRATOR_DB_USER=nucleo_migrator
MIGRATOR_DB_PASSWORD=migrator_dev
# usuário da aplicação (NOBYPASSRLS, só DML)
APP_DB_USER=nucleo_app
APP_DB_PASSWORD=app_dev

DATABASE_URL=postgresql+asyncpg://nucleo_app:app_dev@db:5432/nucleo
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://nucleo_migrator:migrator_dev@db:5432/nucleo

# --- Auth ---
# gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Storage S3 (SeaweedFS em dev, S3 em produção) ---
S3_ENDPOINT_URL=http://storage:8333
# endpoint usado nas URLs pré-assinadas entregues ao navegador/desktop
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=nucleo_dev
S3_SECRET_KEY=nucleo_dev_secret
S3_REGION=us-east-1
S3_BUCKET=nucleo-files

# --- HTTP ---
CORS_ORIGINS=http://localhost:1420,http://localhost:5173,tauri://localhost,http://tauri.localhost
