{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nucleo ERP",
  "version": "0.1.0",
  "identifier": "br.com.nucleoerp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Núcleo ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "ERP para pequenas e médias empresas",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
